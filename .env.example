# Basil Social Studio (all server-only except NEXT_PUBLIC_SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CRON_SECRET=

# Daily private review notification
BASIL_SOCIAL_REVIEW_EMAILS=info@bygoetz.com
BASIL_SOCIAL_FROM=Basil Social Studio <garden@send.bygoetz.com>
BASIL_SOCIAL_REPLY_TO=info@bygoetz.com
BASIL_SOCIAL_DAILY_STORY_COUNT=3

# Repository story source. Public repositories work without GITHUB_TOKEN;
# adding a token raises limits and is required for private repositories.
BASIL_SOCIAL_GITHUB_REPOSITORY=BigHitterG/bygoetz
GITHUB_TOKEN=

# Optional AI refinement. Without this key, the curated Basil story library is used.
OPENAI_API_KEY=
OPENAI_SOCIAL_MODEL=gpt-5.6-terra

# Future publishing connectors. The Studio remains manual until OAuth is completed.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
