# Basil Social Studio (all server-only except NEXT_PUBLIC_SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CRON_SECRET=

# Portland Sun / physical art-print fulfillment. Keep every credential below
# server-only; NEXT_PUBLIC_SITE_URL is the canonical By Goetz origin.
NEXT_PUBLIC_SITE_URL=https://www.bygoetz.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=info@bygoetz.com

# Leave the rate ID empty to use the fixed $8 US standard-shipping fallback.
ART_PRINT_SHIPPING_RATE_ID=
ART_PRINT_SHIPPING_CENTS=800
ART_PRINT_ORDER_EMAILS=info@bygoetz.com
ART_PRINT_FROM_EMAIL=
ART_PRINT_REPLY_TO_EMAIL=info@bygoetz.com

# Daily private review notification
BASIL_SOCIAL_REVIEW_EMAILS=info@bygoetz.com
BASIL_SOCIAL_FROM=Basil Social Studio <garden@send.bygoetz.com>
BASIL_SOCIAL_REPLY_TO=info@bygoetz.com
BASIL_SOCIAL_DAILY_STORY_COUNT=1

# Repository story source. Public repositories work without GITHUB_TOKEN;
# adding a token raises limits and is required for private repositories.
BASIL_SOCIAL_GITHUB_REPOSITORY=BigHitterG/bygoetz
GITHUB_TOKEN=

# Optional AI refinement. Without this key, the curated Basil story library is used.
OPENAI_API_KEY=
OPENAI_SOCIAL_MODEL=gpt-5.6-terra

# Future publishing connectors. The Studio remains manual until OAuth is completed.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Explorers commerce Meta tracking. These are deliberately separate from the
# Basil Pixel/CAPI variables and remain disabled until a dedicated dataset is connected.
NEXT_PUBLIC_EXPLORERS_META_PIXEL_ID=
NEXT_PUBLIC_EXPLORERS_META_TRACKING_ENABLED=false
EXPLORERS_META_CONVERSIONS_API_ENABLED=false
EXPLORERS_META_CONVERSIONS_API_TOKEN=
EXPLORERS_META_GRAPH_API_VERSION=v25.0
EXPLORERS_META_TEST_EVENT_CODE=
